# Cloudinary — galería de fotos (Admin API, solo en build)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ROOT_FOLDER=marbella

# Google Drive — build-time (fuente de fotos alternativa)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# Google Tag Manager — ID del contenedor (formato GTM-XXXXXXX)
# Único proveedor en código; GA4, Clarity, Meta Pixel, etc. se configuran en la UI de GTM.
GTM_CONTAINER_ID=GTM-XXXXXXX
