---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'Marbella Princess Parties',
  description = 'Especialistas en eventos mágicos. Decoración, coordinación, mobiliario, snack bar, mesa de postres, cabina de fotos 360 y espejo mágico.'
} = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#fce8ed"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <title>{title}</title>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
</head>
<body>
  <Navbar/>
  <main><slot/></main>
  <Footer/>
</body>
</html>
