---
import { cldUrl } from '../lib/cloudinary';

const ticker = [
  'XV Años', 'Bodas', 'Graduaciones', 'Bautizos',
  'Cabina 360°', 'Espejo Mágico', 'Mesa de Postres', 'Decoración Floral',
  'XV Años', 'Bodas', 'Graduaciones', 'Bautizos',
  'Cabina 360°', 'Espejo Mágico', 'Mesa de Postres', 'Decoración Floral',
];

const heroBg = cldUrl('PHOTO-2026-05-22-23-21-49_zx4eto', 'f_auto,q_auto,c_fill,g_auto,w_1920,ar_16:9');
const heroCardImg = cldUrl('PHOTO-2026-05-22-22-05-46_vhrkpp', 'f_auto,q_auto,c_fill,g_auto,w_700,ar_3:4');
const heroCardTitle = 'Tu evento soñado';
const heroCardDesc = 'Bodas · XV Años · Graduaciones · Bautizos';
---

<section class="hero" id="inicio">

  <!-- Fondo con imagen real -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src={heroBg}
      alt=""
      class="hero-foto"
    />
    <div class="hero-overlay"></div>
    <div class="hero-overlay-2"></div>
  </div>

  <!-- Pétalos animados -->
  <div class="petals-container" aria-hidden="true">
    <div class="petal p1"></div>
    <div class="petal p2"></div>
    <div class="petal p3"></div>
    <div class="petal p4"></div>
    <div class="petal p5"></div>
  </div>

  <!-- Contenido principal -->
  <div class="container hero-contenido">

    <!-- Columna texto (izquierda) -->
    <div class="hero-texto">
      <span class="hero-eyebrow fade-up d1">Tijuana, Baja California</span>
      <h1 class="hero-titulo fade-up d2">
        Momentos que
        <em>duran para siempre</em>
      </h1>
      <p class="hero-desc fade-up d3">
        Somos el equipo detrás de los eventos más mágicos de Tijuana. Desde la primera idea hasta el último detalle, vivimos tu celebración contigo.
      </p>
      <div class="hero-botones fade-up d4">
        <a href="#contacto" class="btn-rosa" data-track="cta_click" data-track-location="hero">
          <span>Cotiza gratis</span>
          <span>✨</span>
        </a>
        <a href="#galeria" class="btn-outline" data-track="cta_click" data-track-location="hero_galeria">
          <span>Ver galería</span>
        </a>
      </div>

      <!-- Badges de confianza glassmorphism -->
      <div class="hero-badges fade-up d5">
        <div class="badge">
          <span class="badge-num">500+</span>
          <span class="badge-label">Eventos</span>
        </div>
        <div class="badge-divider"></div>
        <div class="badge">
          <span class="badge-num">8+</span>
          <span class="badge-label">Años</span>
        </div>
        <div class="badge-divider"></div>
        <div class="badge">
          <span class="badge-num">5★</span>
          <span class="badge-label">Calificación</span>
        </div>
      </div>
    </div>

    <!-- Tarjeta flotante de presentación (derecha) -->
    <div class="hero-card">
      <img
        src={heroCardImg}
        alt="Mesa de postres decorada para boda - Marbella Princess Parties Tijuana"
        class="card-foto"
        loading="lazy"
      />
      <div class="card-cuerpo">
        <p class="card-titulo">{heroCardTitle}</p>
        <p class="card-desc">{heroCardDesc}</p>
        <a href="#contacto" class="card-cta" data-track="cta_click" data-track-location="hero_card">
          Cotización gratuita
          <svg viewBox="0 0 16 16" fill="none" width="14" height="14">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-hint fade-up d6" aria-hidden="true">
    <div class="scroll-line"></div>
    <span>Descubre más</span>
  </div>

  <!-- Ola inferior -->
  <div class="hero-ola" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,50 C240,90 480,20 720,55 C960,90 1200,20 1440,50 L1440,100 L0,100 Z" fill="#fffaf8"/>
    </svg>
  </div>
</section>

<!-- Marquee ticker de servicios -->
<div class="ticker-wrap" aria-hidden="true">
  <div class="ticker-inner">
    <div class="marquee-track">
      {ticker.map(item => (
        <span class="ticker-item">
          <span class="ticker-dot">✦</span>
          {item}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
/* ---- Hero ---- */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* Background */
.hero-bg {
  position: absolute;
  inset: 0;
}
.hero-foto {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  display: block;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(26, 13, 18, 0.78) 0%,
    rgba(45, 21, 32, 0.65) 40%,
    rgba(61, 37, 53, 0.5) 100%
  );
}
.hero-overlay-2 {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at 60% 40%,
    rgba(232, 132, 154, 0.15) 0%,
    transparent 65%
  );
}

/* Petal rain */
.petals-container {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}
.petal {
  position: absolute;
  width: 8px;
  height: 12px;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  opacity: 0;
  animation: petaloCaer linear infinite;
}
.p1 { background: rgba(247,197,208,0.6); left: 15%; animation-duration: 8s; animation-delay: 0s; }
.p2 { background: rgba(232,132,154,0.4); left: 30%; animation-duration: 11s; animation-delay: 2s; }
.p3 { background: rgba(247,197,208,0.5); left: 55%; animation-duration: 9s; animation-delay: 4s; }
.p4 { background: rgba(212,169,106,0.35); left: 72%; animation-duration: 13s; animation-delay: 1s; }
.p5 { background: rgba(247,197,208,0.45); left: 85%; animation-duration: 10s; animation-delay: 6s; }

/* ---- Layout ---- */
.hero-contenido {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 3rem;
  padding-top: 8rem;
  padding-bottom: 7rem;
}
.hero-texto {
  /* ancho fijo, no crece: evita que el reflow de fuentes mueva el layout */
  flex: 0 1 540px;
  max-width: 540px;
}

/* ---- Texto ---- */
.hero-eyebrow {
  font-family: var(--fuente-cuerpo);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--dorado);
  display: block;
  margin-bottom: 1rem;
}

.hero-titulo {
  font-family: var(--fuente-titulo);
  font-size: clamp(2.6rem, 5.5vw, 4.2rem);
  font-weight: 600;
  color: white;
  line-height: 1.1;
  letter-spacing: -0.01em;
  margin-bottom: 1.5rem;
}
.hero-titulo em {
  display: block;
  font-style: italic;
  font-weight: 400;
  color: var(--rosa-suave);
  font-family: var(--fuente-script);
  font-size: 1.25em;
  line-height: 0.95;
}

.hero-desc {
  font-size: 0.95rem;
  font-weight: 300;
  color: rgba(255,255,255,0.72);
  line-height: 1.85;
  max-width: 420px;
  margin-bottom: 2.25rem;
}

.hero-botones {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}

/* Badges glassmorphism */
.hero-badges {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 16px;
  padding: 1rem 1.5rem;
  width: fit-content;
}
.badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.15rem;
  padding: 0 1.25rem;
}
.badge-num {
  font-family: var(--fuente-titulo);
  font-size: 1.5rem;
  font-weight: 600;
  color: white;
  line-height: 1;
}
.badge-label {
  font-size: 0.65rem;
  font-weight: 400;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
}
.badge-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.15);
}

/* ---- Tarjeta flotante ---- */
.hero-card {
  background: rgba(255, 250, 248, 0.1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 22px;
  overflow: hidden;
  flex: 0 0 280px;
  width: 280px;
  /* margin-left: auto ancla la card a la derecha de forma determinista,
     sin depender de justify-content + reparto de espacio libre */
  margin-left: auto;
  /* fade-in puro sin transform para no romper el layout flex */
  box-shadow: 0 24px 64px rgba(26, 13, 18, 0.4);
}
.hero-card:hover {
  animation-play-state: paused, paused;
  box-shadow: 0 32px 80px rgba(26, 13, 18, 0.5), 0 0 0 1px rgba(255,255,255,0.25);
}
.card-foto {
  width: 100%;
  height: 200px;
  object-fit: cover;
  object-position: center;
  display: block;
}
.card-cuerpo {
  padding: 1.4rem 1.6rem;
}
.card-titulo {
  font-family: var(--fuente-titulo);
  font-size: 1.1rem;
  font-weight: 600;
  color: white;
  margin-bottom: 0.3rem;
}
.card-desc {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
  margin-bottom: 1.1rem;
}
.card-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--dorado-claro);
  transition: gap 0.3s, color 0.3s;
}
.card-cta:hover { gap: 0.7rem; color: var(--dorado); }

/* ---- Scroll hint ---- */
.scroll-hint {
  position: absolute;
  bottom: 7rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
}
.scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.5));
  animation: fadeUp 1.5s ease infinite alternate;
}
.scroll-hint span {
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
}

/* ---- Ola ---- */
.hero-ola {
  position: absolute;
  bottom: -1px; left: 0; right: 0;
  line-height: 0;
  z-index: 3;
}
.hero-ola svg { width: 100%; height: 100px; display: block; }

/* ---- Ticker ---- */
.ticker-wrap {
  background: linear-gradient(135deg, var(--oscuro) 0%, var(--oscuro-medio) 100%);
  overflow: hidden;
  padding: 0.9rem 0;
  position: relative;
  z-index: 10;
}
.ticker-wrap::before,
.ticker-wrap::after {
  content: '';
  position: absolute;
  top: 0; bottom: 0;
  width: 80px;
  z-index: 2;
}
.ticker-wrap::before {
  left: 0;
  background: linear-gradient(to right, var(--oscuro), transparent);
}
.ticker-wrap::after {
  right: 0;
  background: linear-gradient(to left, var(--oscuro), transparent);
}

.ticker-inner {
  overflow: hidden;
  width: 100%;
}

.ticker-item {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0 1.5rem;
  font-family: var(--fuente-cuerpo);
  font-size: 0.72rem;
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  white-space: nowrap;
  transition: color 0.3s;
}
.ticker-item:hover { color: var(--dorado); }
.ticker-dot {
  color: var(--dorado);
  font-size: 0.5rem;
  opacity: 0.7;
}

/* ---- Responsive ---- */
@media (max-width: 800px) {
  .hero-contenido {
    flex-direction: column;
    text-align: center;
    gap: 2.5rem;
    padding-top: 7rem;
    padding-bottom: 5rem;
  }
  .hero-texto { flex: 0 1 auto; max-width: 100%; }
  .hero-titulo { font-size: clamp(2.2rem, 8vw, 3rem); }
  .hero-desc   { margin: 0 auto 2rem; }
  .hero-botones, .hero-badges { justify-content: center; }
  .hero-badges  { margin: 0 auto; }
  .hero-card    { flex: 0 0 auto; width: 260px; margin: 0 auto; }
  .scroll-hint  { display: none; }
}

@media (max-width: 480px) {
  .hero-card { display: none; }
  .hero-titulo { font-size: 2rem; }
}

@keyframes cardEntrada {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes flotar {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-10px); }
}
@keyframes petaloCaer {
  0%   { transform: translateY(-20px) rotate(0deg); opacity: 0; }
  8%   { opacity: 0.7; }
  100% { transform: translateY(105vh) rotate(600deg); opacity: 0; }
}
@keyframes fadeUp {
  from { opacity: 0.2; transform: translateY(4px); }
  to   { opacity: 0.7; transform: translateY(0); }
}
</style>
