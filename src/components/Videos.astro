---
import { getGalleryVideos } from '../lib/cloudinary';

const videos = await getGalleryVideos();
---

{videos.length > 0 && (
<section class="reels" id="videos">
  <div class="container">
    <div class="sec-header reveal">
      <span class="eyebrow">En movimiento</span>
      <h2 class="sec-titulo">Momentos en <em>video</em></h2>
      <div class="sep"><span class="sep-icon">🎥</span></div>
      <p class="sec-desc">Revive la energía de nuestros eventos. Toca un reel para reproducirlo.</p>
    </div>

    <!-- Carrusel horizontal de reels 9:16 -->
    <div class="reel-carousel" role="list">
      {videos.map((v, i) => (
        <button
          class="reel-card reveal"
          role="listitem"
          data-index={i}
          data-src={v.src}
          aria-label={`Reproducir video de ${v.titulo}`}
        >
          <img
            src={v.poster}
            width="400"
            height="711"
            alt={`Video de evento — ${v.titulo} — Marbella Princess Parties Tijuana`}
            loading="lazy"
            decoding="async"
            class="reel-poster"
          />
          <span class="reel-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </span>
          <span class="reel-cat">{v.titulo}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Modal de video -->
  <div class="vlb" id="vlb" role="dialog" aria-modal="true" aria-label="Reproductor de video">
    <div class="vlb-backdrop" id="vlb-backdrop"></div>
    <button class="vlb-close" id="vlb-close" aria-label="Cerrar">✕</button>
    <button class="vlb-prev"  id="vlb-prev"  aria-label="Video anterior">‹</button>
    <button class="vlb-next"  id="vlb-next"  aria-label="Video siguiente">›</button>
    <div class="vlb-stage">
      <video id="vlb-video" class="vlb-video" controls playsinline preload="none"></video>
    </div>
  </div>
</section>
)}

<style>
.reels {
  padding: 6rem 0;
  background: var(--blanco, #fff);
  position: relative;
  overflow: hidden;
}
.reels::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--rosa-suave), transparent);
}

/* Header (mismo patrón que Gallery/Testimonials) */
.sec-header { text-align: center; max-width: 560px; margin: 0 auto 3rem; }
.sec-titulo { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 600; color: var(--texto); }
.sec-titulo em {
  font-style: italic; color: var(--rosa-oscuro); font-weight: 400;
  font-family: var(--fuente-script);
}
.sec-desc { color: var(--texto-claro); font-size: 0.95rem; line-height: 1.8; margin-top: 0.75rem; }

/* Carrusel */
.reel-carousel {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(180px, 200px);
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 0.5rem;
}
.reel-carousel::-webkit-scrollbar { display: none; }

/* Tarjeta de reel */
.reel-card {
  position: relative;
  aspect-ratio: 9 / 16;
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
  border: 1px solid var(--crema-borde);
  padding: 0;
  background: var(--rosa-palido);
  scroll-snap-align: start;
  box-shadow: 0 4px 16px rgba(61,37,53,0.08);
  transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.4s ease;
}
.reel-card:hover, .reel-card:focus-visible {
  transform: translateY(-6px);
  box-shadow: var(--sombra-rosa, 0 12px 30px rgba(232,132,154,0.28));
  outline: none;
}
.reel-poster {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.reel-card::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(61,37,53,0.55) 0%, transparent 45%);
  pointer-events: none;
}
.reel-play {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 56px; height: 56px;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(6px);
  border: 1.5px solid rgba(255,255,255,0.5);
  color: white;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s, transform 0.3s;
  z-index: 2;
}
.reel-play svg { margin-left: 3px; }
.reel-card:hover .reel-play { background: var(--rosa); border-color: var(--rosa); }
.reel-cat {
  position: absolute; bottom: 0.7rem; left: 0.8rem; right: 0.8rem;
  z-index: 2;
  font-family: var(--fuente-titulo);
  font-size: 0.8rem; font-weight: 600; color: white;
  text-align: left;
}

/* Reveal */
.reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.55s ease, transform 0.55s ease; }
.reveal.in-view { opacity: 1; transform: none; }

/* Modal (lightbox de video) */
.vlb {
  position: fixed; inset: 0; z-index: 600;
  display: none; align-items: center; justify-content: center;
}
.vlb.open { display: flex; animation: aparecer 0.3s ease; }
.vlb-backdrop {
  position: absolute; inset: 0;
  background: rgba(30,10,20,0.94);
  backdrop-filter: blur(12px);
}
.vlb-stage {
  position: relative; z-index: 2;
  max-width: 92vw; max-height: 90vh;
  display: flex; align-items: center; justify-content: center;
}
.vlb-video {
  max-width: min(420px, 92vw);
  max-height: 90vh;
  width: auto; height: auto;
  aspect-ratio: 9 / 16;
  background: #000;
  border-radius: 14px;
  box-shadow: 0 24px 60px rgba(0,0,0,0.5);
}
.vlb-close, .vlb-prev, .vlb-next {
  position: fixed;
  background: rgba(255,255,255,0.12);
  border: 1.5px solid rgba(255,255,255,0.25);
  color: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s; z-index: 3;
}
.vlb-close { top: 1.5rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%; font-size: 1.1rem; }
.vlb-prev, .vlb-next {
  top: 50%; transform: translateY(-50%);
  width: 48px; height: 48px; border-radius: 50%;
  font-size: 1.8rem; line-height: 1;
}
.vlb-prev { left: 1.5rem; }
.vlb-next { right: 1.5rem; }
.vlb-close:hover, .vlb-prev:hover, .vlb-next:hover { background: var(--rosa); border-color: var(--rosa); }

@media (max-width: 760px) {
  .reel-carousel { grid-auto-columns: 62%; }
  .vlb-prev, .vlb-next { width: 40px; height: 40px; }
  .vlb-prev { left: 0.5rem; }
  .vlb-next { right: 0.5rem; }
}

@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; transform: none; transition: none; }
  .reel-card { transition: none; }
  .vlb.open { animation: none; }
}
</style>

<script>
  // Reveal (mismo patrón que Gallery)
  const revealObs = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in-view'); revealObs.unobserve(e.target); }
    }),
    { threshold: 0.06 }
  );
  document.querySelectorAll<HTMLElement>('.reels .reveal').forEach(el => revealObs.observe(el));

  const modal    = document.getElementById('vlb');
  const video    = document.getElementById('vlb-video') as HTMLVideoElement | null;
  const backdrop = document.getElementById('vlb-backdrop');
  const btnClose = document.getElementById('vlb-close');
  const btnPrev  = document.getElementById('vlb-prev');
  const btnNext  = document.getElementById('vlb-next');
  const cards    = Array.from(document.querySelectorAll<HTMLButtonElement>('.reel-card'));

  if (modal && video && cards.length) {
    let cur = 0;

    function load(idx: number) {
      cur = (idx + cards.length) % cards.length;
      const src = cards[cur].dataset.src || '';
      video!.pause();
      video!.setAttribute('src', src);
      video!.load();
      video!.play().catch(() => { /* el usuario puede darle play manual */ });
    }

    function open(idx: number) {
      load(idx);
      modal!.classList.add('open');
      document.body.style.overflow = 'hidden';
      btnClose?.focus();
    }

    function close() {
      modal!.classList.remove('open');
      document.body.style.overflow = '';
      // Liberar el buffer: garantiza que ningún video siga cargando/sonando.
      video!.pause();
      video!.removeAttribute('src');
      video!.load();
    }

    cards.forEach((card, i) => card.addEventListener('click', () => open(i)));
    btnClose?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    btnPrev?.addEventListener('click', () => load(cur - 1));
    btnNext?.addEventListener('click', () => load(cur + 1));

    document.addEventListener('keydown', e => {
      if (!modal!.classList.contains('open')) return;
      if (e.key === 'Escape')     close();
      if (e.key === 'ArrowLeft')  load(cur - 1);
      if (e.key === 'ArrowRight') load(cur + 1);
    });
  }
</script>
