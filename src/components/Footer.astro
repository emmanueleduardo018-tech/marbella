---
const year = new Date().getFullYear();
const servicios = ['Decoración','Coordinación','Renta de Mobiliario','Snack Bar','Mesa de Postres','Cabina de Fotos','Cabina 360°','Espejo Mágico'];
const eventos = ['Bodas','XV Años','Graduaciones','Bautizos','Cumpleaños','Corporativos'];
---

<footer class="footer">

  <!-- Ola decorativa superior -->
  <div class="footer-ola" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,50 C240,90 480,10 720,50 C960,90 1200,10 1440,50 L1440,100 L0,100 Z" fill="#1a0d12"/>
    </svg>
  </div>

  <!-- Cuerpo oscuro -->
  <div class="footer-cuerpo">

    <!-- Patrón decorativo -->
    <div class="footer-pattern" aria-hidden="true"></div>

    <!-- Brillo superior -->
    <div class="footer-glow" aria-hidden="true"></div>

    <div class="container">

      <!-- CTA superior del footer -->
      <div class="footer-cta-top">
        <div class="footer-cta-texto">
          <span class="footer-script">¿Lista para crear algo mágico?</span>
          <p>Cada evento comienza con una conversación. Cuéntanos tu sueño.</p>
        </div>
        <a href="#contacto" class="btn-dorado footer-cta-btn" data-track="cta_click" data-track-location="footer_cta">
          <span>Cotizar mi evento</span>
          <span>🎀</span>
        </a>
      </div>

      <div class="footer-divisor" aria-hidden="true"></div>

      <!-- Grid del footer -->
      <div class="footer-grid">

        <!-- Marca -->
        <div class="footer-marca">
          <div class="footer-logo">
            <div class="footer-corona" aria-hidden="true">
              <svg viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="24">
                <path d="M16 2L20 10L28 6L24 16H8L4 6L12 10L16 2Z" fill="currentColor" opacity="0.85"/>
                <path d="M6 18H26V22C26 23.1 25.1 24 24 24H8C6.9 24 6 23.1 6 22V18Z" fill="currentColor" opacity="0.6"/>
                <circle cx="16" cy="10" r="2" fill="white" opacity="0.8"/>
              </svg>
            </div>
            <div>
              <span class="flogo-nombre">Marbella</span>
              <span class="flogo-sub">Princess Parties</span>
            </div>
          </div>
          <p class="footer-tagline">
            Transformamos tus momentos más especiales en recuerdos mágicos que duran para siempre.
          </p>

          <!-- Social -->
          <div class="footer-social">
            <a href="https://instagram.com/marbellalara87" target="_blank" rel="noopener" class="social-btn" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            <a href="https://wa.me/526644771880" target="_blank" rel="noopener" class="social-btn social-wa" aria-label="WhatsApp" data-track="whatsapp_click" data-track-location="footer_social">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
            <a href="https://facebook.com/marbellaprincessparties" target="_blank" rel="noopener" class="social-btn" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
          </div>

          <!-- Contacto rápido -->
          <div class="footer-contacto">
            <a href="tel:+526644771880" class="footer-tel" data-track="phone_click" data-track-location="footer">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                <path d="M6.6 1.8A15.5 15.5 0 0118.2 13.4l-3 3a1 1 0 01-1.4 0l-2-2a1 1 0 010-1.4l1-1a6.5 6.5 0 00-5.8-5.8l-1 1a1 1 0 01-1.4 0l-2-2a1 1 0 010-1.4l3-3z"/>
              </svg>
              664 477 1880
            </a>
            <span class="footer-ubicacion">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                <path d="M10 2a6 6 0 016 6c0 5-6 10-6 10S4 13 4 8a6 6 0 016-6z"/>
                <circle cx="10" cy="8" r="2"/>
              </svg>
              Tijuana, Baja California
            </span>
          </div>
        </div>

        <!-- Servicios -->
        <div class="footer-col">
          <h4 class="footer-h">Servicios</h4>
          <ul class="footer-ul">
            {servicios.map(s => <li><a href="#servicios">{s}</a></li>)}
          </ul>
        </div>

        <!-- Eventos -->
        <div class="footer-col">
          <h4 class="footer-h">Eventos</h4>
          <ul class="footer-ul">
            {eventos.map(e => <li><a href="#galeria">{e}</a></li>)}
          </ul>
        </div>

        <!-- Newsletter / CTA columna -->
        <div class="footer-col">
          <h4 class="footer-h">¿Tienes un evento?</h4>
          <p class="footer-col-desc">
            Escríbenos directamente y te respondemos en menos de 1 hora.
          </p>
          <div class="footer-actions">
            <a href="https://wa.me/526644771880" target="_blank" rel="noopener" class="footer-action-btn wa-btn" data-track="whatsapp_click" data-track-location="footer_action">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
            <a href="mailto:marbellalara408@gmail.com" class="footer-action-btn email-btn" data-track="email_click" data-track-location="footer_action">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              Email
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="footer-bottom">
        <p>© {year} Marbella Princess Parties · Tijuana, México · Hecho con 💖</p>
        <div class="footer-legal">
          <a href="#">Privacidad</a>
          <span>·</span>
          <a href="#">Términos</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Botón flotante WhatsApp con pulso -->
<a href="https://wa.me/526644771880" target="_blank" rel="noopener" class="wa-float" aria-label="Abrir WhatsApp" data-track="whatsapp_click" data-track-location="float">
  <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
