<style>
.footer { background: #fce8ed; }
.footer-ola { line-height:0; }
.footer-ola svg { width:100%; height:80px; display:block; }

.footer-cuerpo {
  background: #fce8ed;
  padding: 3.5rem 0;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
  gap: 3rem;
}

/* Marca */
.footer-logo {
  display: flex; align-items: center; gap: 0.6rem;
  margin-bottom: 0.9rem; font-size: 1.5rem;
}
.flogo-nombre {
  display: block;
  font-family: var(--fuente-script);
  font-size: 1.4rem; color: var(--rosa-oscuro); line-height: 1;
}
.flogo-sub {
  display: block;
  font-size: 0.58rem; font-weight: 500;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--texto-claro); line-height: 1;
}
.footer-tagline {
  font-size: 0.83rem; color: var(--texto-medio);
  line-height: 1.7; margin-bottom: 1.25rem;
  max-width: 260px;
}
.footer-social { display: flex; gap: 0.5rem; }
.social-btn {
  width: 36px; height: 36px; border-radius: 10px;
  background: white; border: 1.5px solid var(--crema-borde);
  color: var(--texto-medio);
  display: flex; align-items: center; justify-content: center;
  transition: var(--transicion);
}
.social-btn:hover { background: var(--rosa); border-color: var(--rosa); color: white; }

/* Columnas */
.footer-h {
  font-family: var(--fuente-cuerpo);
  font-size: 0.68rem; font-weight: 600;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--rosa-oscuro); margin-bottom: 1rem;
}
.footer-ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
.footer-ul li a, .footer-ul li span {
  font-size: 0.83rem; color: var(--texto-medio);
  transition: color 0.3s;
}
.footer-ul li a:hover { color: var(--rosa-oscuro); }
.footer-cta-btn { margin-top: 1.25rem; font-size: 0.78rem; padding: 0.7rem 1.25rem; }

/* Bottom */
.footer-bottom {
  background: rgba(232,132,154,0.15);
  padding: 1.1rem 0;
  border-top: 1px solid rgba(232,132,154,0.25);
}
.footer-bottom-inner {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 0.5rem;
}
.footer-bottom p { font-size: 0.75rem; color: var(--texto-claro); }
.footer-legal { display: flex; gap: 0.75rem; align-items: center; }
.footer-legal a { font-size: 0.75rem; color: var(--texto-claro); }
.footer-legal a:hover { color: var(--rosa-oscuro); }
.footer-legal span { color: var(--rosa-suave); }

/* WA float */
.wa-float {
  position: fixed; bottom: 2rem; right: 2rem;
  width: 58px; height: 58px; border-radius: 50%;
  background: #25d366; color: white;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 24px rgba(37,211,102,0.4);
  z-index: 300; transition: all 0.3s ease;
}
.wa-float:hover { transform: scale(1.12); box-shadow: 0 8px 30px rgba(37,211,102,0.55); }
.wa-tip {
  position: absolute; right: 70px;
  background: white; color: var(--texto);
  font-size: 0.78rem; font-weight: 500;
  padding: 0.4rem 0.85rem;
  border-radius: 50px;
  box-shadow: var(--sombra-suave);
  border: 1px solid var(--crema-borde);
  white-space: nowrap;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s;
}
.wa-float:hover .wa-tip { opacity: 1; }

@media (max-width: 900px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
}
@media (max-width: 520px) {
  .footer-grid { grid-template-columns: 1fr; }
  .footer-bottom-inner { flex-direction: column; text-align: center; }
}
</style>
