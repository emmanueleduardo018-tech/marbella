  <span class="wa-tip" aria-hidden="true">¡Escríbenos! 🌸</span>
</a>

<style>
/* Footer base */
.footer { background: var(--blanco); }

.footer-ola {
  line-height: 0;
  background: var(--blanco);
}
.footer-ola svg { width: 100%; height: 100px; display: block; }

/* Cuerpo oscuro */
.footer-cuerpo {
  background: var(--oscuro);
  padding: 4rem 0 0;
  position: relative;
  overflow: hidden;
}

/* Patrón de puntos */
.footer-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(247,197,208,0.04) 1px, transparent 1px);
  background-size: 32px 32px;
  pointer-events: none;
}

/* Glow radial */
.footer-glow {
  position: absolute;
  top: -200px; left: 50%; transform: translateX(-50%);
  width: 900px; height: 500px;
  background: radial-gradient(ellipse, rgba(232,132,154,0.08), transparent 60%);
  pointer-events: none;
}

/* ---- CTA Superior ---- */
.footer-cta-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 2.5rem 3rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 22px;
  margin-bottom: 3.5rem;
  flex-wrap: wrap;
}
.footer-cta-texto { flex: 1; min-width: 240px; }
.footer-script {
  display: block;
  font-family: var(--fuente-script);
  font-size: 2rem;
  color: var(--rosa-suave);
  line-height: 1.1;
  margin-bottom: 0.3rem;
}
.footer-cta-texto p {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.6;
}
.footer-cta-btn {
  flex-shrink: 0;
  font-size: 0.8rem;
  padding: 0.85rem 2rem;
}

/* Divisor */
.footer-divisor {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
  margin-bottom: 3.5rem;
}

/* Grid */
.footer-grid {
  display: grid;
  grid-template-columns: 1.7fr 1fr 1fr 1.2fr;
  gap: 3rem;
  margin-bottom: 3.5rem;
}

/* Marca */
.footer-logo {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 1rem;
}
.footer-corona {
  color: var(--rosa-suave);
  opacity: 0.8;
}
.flogo-nombre {
  display: block;
  font-family: var(--fuente-script);
  font-size: 1.5rem;
  color: var(--rosa-suave);
  line-height: 1;
}
.flogo-sub {
  display: block;
  font-size: 0.55rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
}
.footer-tagline {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.42);
  line-height: 1.75;
  margin-bottom: 1.25rem;
  max-width: 260px;
}

/* Social */
.footer-social {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}
.social-btn {
  width: 36px; height: 36px;
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.5);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.3s ease;
  text-decoration: none;
}
.social-btn:hover {
  background: var(--rosa);
  border-color: var(--rosa);
  color: white;
  transform: translateY(-2px);
}
.social-wa:hover { background: #25d366; border-color: #25d366; }

/* Contacto rápido */
.footer-contacto {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.footer-tel,
.footer-ubicacion {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.4);
  transition: color 0.3s;
  text-decoration: none;
}
.footer-tel:hover { color: var(--rosa-suave); }

/* Columnas */
.footer-h {
  font-family: var(--fuente-cuerpo);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--dorado);
  margin-bottom: 1.1rem;
}
.footer-ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}
.footer-ul li a {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.42);
  transition: color 0.3s;
  text-decoration: none;
}
.footer-ul li a:hover { color: rgba(255,255,255,0.8); }

.footer-col-desc {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.38);
  line-height: 1.65;
  margin-bottom: 1.25rem;
}

.footer-actions {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.footer-action-btn {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.7rem 1.1rem;
  border-radius: 10px;
  font-size: 0.78rem;
  font-weight: 500;
  transition: all 0.3s;
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.55);
  background: rgba(255,255,255,0.04);
}
.footer-action-btn:hover {
  background: rgba(255,255,255,0.08);
  color: white;
  border-color: rgba(255,255,255,0.2);
}
.wa-btn:hover { background: rgba(37,211,102,0.12); border-color: rgba(37,211,102,0.3); color: #4ade80; }

/* Bottom bar */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.07);
  padding: 1.5rem 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.footer-bottom p {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.25);
}
.footer-legal {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}
.footer-legal a {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.25);
  transition: color 0.3s;
  text-decoration: none;
}
.footer-legal a:hover { color: var(--rosa-suave); }
.footer-legal span { color: rgba(255,255,255,0.15); }

/* ---- WhatsApp Float ---- */
.wa-float {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: #25d366;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 24px rgba(37,211,102,0.45);
  z-index: 300;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  animation: pulso-wa 2.5s ease-in-out infinite;
  text-decoration: none;
}
.wa-float:hover {
  transform: scale(1.12);
  box-shadow: 0 10px 36px rgba(37,211,102,0.6);
  animation: none;
}
.wa-tip {
  position: absolute;
  right: 72px;
  background: white;
  color: var(--texto);
  font-family: var(--fuente-cuerpo);
  font-size: 0.78rem;
  font-weight: 500;
  padding: 0.45rem 0.9rem;
  border-radius: 50px;
  box-shadow: 0 4px 20px rgba(61, 37, 53, 0.12);
  border: 1px solid var(--crema-borde);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.wa-float:hover .wa-tip { opacity: 1; }

@media (max-width: 1000px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .footer-cta-top { padding: 2rem 1.75rem; }
}
@media (max-width: 600px) {
  .footer-grid { grid-template-columns: 1fr; }
  .footer-bottom { flex-direction: column; text-align: center; }
  .footer-cta-top { flex-direction: column; text-align: center; align-items: center; }
  .footer-cta-btn { width: 100%; justify-content: center; }
}

@keyframes pulso-wa {
  0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
  70%  { box-shadow: 0 0 0 18px rgba(37, 211, 102, 0); }
  100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
}
</style>
