---
const categorias = [
  { id:'all',             label:'✨ Todos'             },
  { id:'bodas',           label:'💍 Bodas'             },
  { id:'xv',              label:'👑 XV Años'           },
  { id:'graduaciones',    label:'🎓 Graduaciones'      },
  { id:'bautizos',        label:'🕊️ Bautizos'         },
  { id:'cumpleanos',      label:'🎂 Cumpleaños'        },
  { id:'corporativos',    label:'🏢 Corporativos'      },
  { id:'centrosdemesa',   label:'🌸 Centros de mesa'   },
  { id:'fiestasinf',      label:'🎉 Fiestas infantiles'},
];
---

<section class="galeria" id="galeria">
  <div class="container">
    <div class="sec-header">
      <span class="eyebrow">Nuestro trabajo</span>
      <h2 class="sec-titulo">Galería de <em>eventos</em></h2>
      <div class="sep"><span class="sep-icon">📸</span></div>
      <p class="sec-desc">Explora por categoría y déjate inspirar para tu próximo evento.</p>
    </div>

    <!-- Filtros -->
    <div class="filtros" id="filtros">
      {categorias.map(c => (
        <button class={`filtro-btn ${c.id==='all'?'activo':''}`} data-filtro={c.id}>
          {c.label}
        </button>
      ))}
    </div>

    <!-- Grid (poblado por cliente con SWR) -->
    <div class="foto-grid" id="foto-grid"></div>

    <div class="ver-mas-wrap" id="ver-mas-wrap">
      <button class="ver-mas-btn" id="ver-mas-btn">Ver más fotos</button>
    </div>

    <div class="galeria-cta">
      <a href="#contacto" class="btn-rosa">¿Quieres un evento así? ✨</a>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
  <div class="lb-backdrop" id="lb-backdrop"></div>
  <button class="lb-close" id="lb-close" aria-label="Cerrar">✕</button>
  <button class="lb-prev"  id="lb-prev"  aria-label="Anterior">‹</button>
  <button class="lb-next"  id="lb-next"  aria-label="Siguiente">›</button>
  <div class="lb-content">
    <img src="" alt="" id="lb-img" />
    <p class="lb-caption" id="lb-caption"></p>
  </div>
</div>

<style>
.galeria {
  padding: 6rem 0 5rem;
  background: var(--crema);
  position: relative;
}
.galeria::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--rosa-suave), transparent);
}

/* Header */
.sec-header { text-align: center; max-width: 560px; margin: 0 auto 3rem; }
.sec-titulo { font-size: clamp(2rem,4vw,2.8rem); font-weight:600; color:var(--texto); }
.sec-titulo em { font-style:italic; color:var(--rosa-oscuro); font-weight:400; }
.sec-desc { color:var(--texto-claro); font-size:0.95rem; line-height:1.8; margin-top:0.75rem; }

/* Filtros */
.filtros {
  display: flex; flex-wrap: wrap;
  justify-content: center; gap: 0.6rem;
  margin-bottom: 2.5rem;
}
.filtro-btn {
  padding: 0.5rem 1.2rem;
  background: white;
  border: 1.5px solid var(--crema-borde);
  border-radius: 50px;
  font-family: var(--fuente-cuerpo);
  font-size: 0.8rem; font-weight: 400;
  color: var(--texto-medio);
  cursor: pointer;
  transition: var(--transicion);
}
.filtro-btn:hover {
  border-color: var(--rosa-suave);
  color: var(--rosa-oscuro);
}
.filtro-btn.activo {
  background: var(--rosa);
  border-color: var(--rosa);
  color: white;
  box-shadow: 0 4px 14px rgba(232,132,154,0.3);
}

/* Grid */
.foto-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 1rem;
}
.foto-item {
  transition: opacity 0.4s ease;
}
.foto-item.oculto     { display: none; }
.foto-item.pag-oculto { display: none; }

.foto-wrap {
  position: relative;
  aspect-ratio: 4/3;
  border-radius: 14px;
  overflow: hidden;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(61,37,53,0.07);
}
@keyframes shimmer {
  from { background-position: -600px 0; }
  to   { background-position:  600px 0; }
}
.foto-img {
  width: 100%; height: 100%;
  background: linear-gradient(90deg, var(--rosa-palido) 25%, #f5d0da 50%, var(--rosa-palido) 75%);
  background-size: 1200px 100%;
  animation: shimmer 1.6s ease infinite;
  transition: transform 0.55s cubic-bezier(0.25,0.46,0.45,0.94);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.foto-img.cargado {
  background: var(--rosa-palido);
  animation: none;
}
.foto-imagen {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
}
.foto-wrap:hover .foto-img { transform: scale(1.07); }
.foto-placeholder {
  font-size: 2.5rem; opacity: 0.4;
  pointer-events: none;
}

.foto-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(61,37,53,0.75) 0%, transparent 55%);
  opacity: 0; transition: opacity 0.35s ease;
  display: flex; flex-direction: column;
  justify-content: flex-end; padding: 1rem;
}
.foto-wrap:hover .foto-overlay { opacity: 1; }
.foto-titulo {
  font-family: var(--fuente-titulo);
  font-size: 0.95rem; font-weight: 600; color: white; line-height: 1.2;
}
.foto-desc { font-size: 0.72rem; color: rgba(255,255,255,0.75); margin-top: 0.15rem; }
.foto-zoom {
  position: absolute; top: 0.75rem; right: 0.75rem;
  width: 34px; height: 34px;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.35);
  border-radius: 50%;
  color: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s;
}
.foto-zoom:hover { background: var(--rosa); border-color: var(--rosa); }

.ver-mas-wrap { text-align: center; margin-top: 2rem; }
.ver-mas-btn {
  padding: 0.7rem 2rem;
  background: white;
  border: 1.5px solid var(--rosa-suave);
  border-radius: 50px;
  font-family: var(--fuente-cuerpo);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--rosa-oscuro);
  cursor: pointer;
  transition: var(--transicion);
  display: inline-flex; align-items: center; gap: 0.4rem;
}
.ver-mas-btn:hover {
  background: var(--rosa);
  border-color: var(--rosa);
  color: white;
  box-shadow: 0 4px 14px rgba(232,132,154,0.3);
}
.ver-mas-btn[hidden] { display: none; }

.galeria-cta { text-align: center; margin-top: 3rem; }

/* Reveal */
.reveal { opacity:0; transform:translateY(20px); transition: opacity 0.55s ease, transform 0.55s ease; }
.reveal.in-view { opacity:1; transform:none; }

/* Lightbox */
.lightbox {
  position: fixed; inset: 0; z-index: 500;
  display: none; align-items: center; justify-content: center;
}
.lightbox.open { display: flex; animation: aparecer 0.3s ease; }
.lb-backdrop {
  position: absolute; inset: 0;
  background: rgba(30,10,20,0.92);
  backdrop-filter: blur(12px);
}
.lb-content {
  position: relative; z-index: 2;
  display: flex; flex-direction: column;
  align-items: center; gap: 1rem;
  max-width: 90vw; max-height: 90vh;
}
#lb-img {
  max-width: 80vw; max-height: 80vh;
  object-fit: contain;
  border-radius: 12px;
  box-shadow: 0 24px 60px rgba(0,0,0,0.5);
}
.lb-caption {
  color: rgba(255,255,255,0.7);
  font-family: var(--fuente-titulo);
  font-style: italic; font-size: 1rem;
}
.lb-close, .lb-prev, .lb-next {
  position: fixed;
  background: rgba(255,255,255,0.12);
  border: 1.5px solid rgba(255,255,255,0.25);
  color: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s;
  z-index: 3;
}
.lb-close {
  top: 1.5rem; right: 1.5rem;
  width: 44px; height: 44px; border-radius: 50%;
  font-size: 1.1rem;
}
.lb-prev, .lb-next {
  top: 50%; transform: translateY(-50%);
  width: 48px; height: 48px; border-radius: 50%;
  font-size: 1.8rem; line-height: 1;
}
.lb-prev { left: 1.5rem; }
.lb-next { right: 1.5rem; }
.lb-close:hover, .lb-prev:hover, .lb-next:hover {
  background: var(--rosa);
  border-color: var(--rosa);
}

@media (max-width: 900px)  { .foto-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 480px)  { .foto-grid { grid-template-columns: repeat(2,1fr); gap:0.6rem; } }
</style>

<script>
  // ── Config (reemplazados por Astro en build) ──────────────────────────────
  const API_KEY  = import.meta.env.PUBLIC_GOOGLE_DRIVE_API_KEY  as string;
  const ROOT_ID  = import.meta.env.PUBLIC_GOOGLE_DRIVE_ROOT_FOLDER_ID as string;
  const CACHE_KEY = 'marbella_galeria_v2';
  const TTL       = 30 * 60 * 1000; // 30 minutos

  const CAT_META: Record<string, { titulo: string; desc: string }> = {
    bodas:         { titulo: 'Boda',               desc: 'Ceremonias y recepciones'   },
    xv:            { titulo: 'XV Años',            desc: 'Quinceañeras'               },
    graduaciones:  { titulo: 'Graduación',         desc: 'Celebración de logros'      },
    bautizos:      { titulo: 'Bautizo',            desc: 'Celebración de bautizo'     },
    cumpleanos:    { titulo: 'Cumpleaños',         desc: 'Fiestas de cumpleaños'      },
    corporativos:  { titulo: 'Corporativo',        desc: 'Eventos empresariales'      },
    centrosdemesa: { titulo: 'Centros de mesa',    desc: 'Decoración para eventos'    },
    fiestasinf:    { titulo: 'Fiestas infantiles', desc: 'Celebraciones para niños'   },
  };

  interface Foto { src: string; cat: string; titulo: string; desc: string; }

  // ── Cache localStorage ────────────────────────────────────────────────────
  function cacheGet(): Foto[] | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const { ts, fotos } = JSON.parse(raw) as { ts: number; fotos: Foto[] };
      return Date.now() - ts < TTL ? fotos : null;
    } catch { return null; }
  }
  function cacheSet(fotos: Foto[]) {
    try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), fotos })); } catch {}
  }

  // ── Drive API cliente ─────────────────────────────────────────────────────
  function normCat(name: string) {
    return name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '');
  }
  async function driveList(q: string, fields: string, token?: string): Promise<any[]> {
    const u = new URL('https://www.googleapis.com/drive/v3/files');
    u.searchParams.set('q', q);
    u.searchParams.set('fields', `files(${fields}),nextPageToken`);
    u.searchParams.set('key', API_KEY);
    u.searchParams.set('pageSize', '100');
    if (token) u.searchParams.set('pageToken', token);
    const j = await fetch(u.toString()).then(r => r.json());
    const items: any[] = j.files ?? [];
    return j.nextPageToken ? [...items, ...await driveList(q, fields, j.nextPageToken)] : items;
  }
  async function fetchFotos(): Promise<Foto[]> {
    const folders = await driveList(
      `'${ROOT_ID}' in parents and mimeType='application/vnd.google-apps.folder' and trashed=false`,
      'id,name'
    );
    const result: Foto[] = [];
    await Promise.all(folders.map(async folder => {
      const cat  = normCat(folder.name);
      const meta = CAT_META[cat];
      if (!meta) return;
      const files = await driveList(
        `'${folder.id}' in parents and mimeType contains 'image/' and trashed=false`,
        'id,name'
      );
      for (const f of files)
        result.push({ src: `https://lh3.googleusercontent.com/d/${f.id}`, cat, titulo: meta.titulo, desc: meta.desc });
    }));
    return result;
  }

  // ── Render ────────────────────────────────────────────────────────────────
  const LOTE = 12;
  let filtroActivo = 'all';
  let mostrados    = LOTE;
  const grid = document.getElementById('foto-grid')!;

  const revealObs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in-view'); revealObs.unobserve(e.target); } }),
    { threshold: 0.06 }
  );

  function todosItems(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('.foto-item'));
  }
  function refreshGrid() {
    const items = todosItems();
    items.forEach(item => {
      item.classList.toggle('oculto', filtroActivo !== 'all' && item.dataset.cat !== filtroActivo);
      item.classList.remove('pag-oculto');
    });
    const visibles = items.filter(i => !i.classList.contains('oculto'));
    visibles.forEach((item, idx) => item.classList.toggle('pag-oculto', idx >= mostrados));
    const btn = document.getElementById('ver-mas-btn') as HTMLButtonElement | null;
    if (btn) {
      const rest = Math.max(0, visibles.length - mostrados);
      btn.hidden = rest <= 0;
      btn.textContent = `Ver ${Math.min(LOTE, rest)} fotos más`;
    }
  }

  function crearItem(f: Foto, i: number): HTMLElement {
    const div  = document.createElement('div');
    div.className   = 'foto-item reveal';
    div.dataset.cat = f.cat;
    div.dataset.i   = String(i);

    const wrap    = document.createElement('div');
    wrap.className = 'foto-wrap';

    const fotoImg    = document.createElement('div');
    fotoImg.className = 'foto-img';
    const img = document.createElement('img');
    img.src       = f.src;
    img.alt       = `${f.titulo} - ${f.desc} - Marbella Princess Parties Tijuana`;
    img.className = 'foto-imagen';
    img.loading   = i < 8 ? 'eager' : 'lazy';
    img.decoding  = 'async';
    if (i < 4) img.setAttribute('fetchpriority', 'high');
    img.addEventListener('load', () => fotoImg.classList.add('cargado'));
    fotoImg.appendChild(img);

    const overlay    = document.createElement('div');
    overlay.className = 'foto-overlay';
    overlay.innerHTML = `
      <div class="foto-info">
        <p class="foto-titulo">${f.titulo}</p>
        <p class="foto-desc">${f.desc}</p>
      </div>
      <button class="foto-zoom" aria-label="Ver">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
        </svg>
      </button>`;

    wrap.appendChild(fotoImg);
    wrap.appendChild(overlay);
    wrap.addEventListener('click', () => {
      const vis = Array.from(document.querySelectorAll<HTMLElement>('.foto-item:not(.oculto):not(.pag-oculto)'));
      abrir(vis.indexOf(div));
    });
    div.appendChild(wrap);
    return div;
  }

  function showSkeleton() {
    grid.innerHTML = Array(8).fill(0).map(() =>
      `<div class="foto-item foto-skeleton"><div class="foto-wrap"><div class="foto-img"></div></div></div>`
    ).join('');
  }

  function renderFotos(fotos: Foto[]) {
    grid.innerHTML = '';
    fotos.forEach((f, i) => { const item = crearItem(f, i); grid.appendChild(item); revealObs.observe(item); });
    mostrados    = LOTE;
    filtroActivo = 'all';
    document.querySelectorAll<HTMLButtonElement>('.filtro-btn').forEach(b =>
      b.classList.toggle('activo', b.dataset.filtro === 'all')
    );
    refreshGrid();
  }

  // ── Init SWR ──────────────────────────────────────────────────────────────
  async function init() {
    const cached = cacheGet();
    if (cached) {
      renderFotos(cached);
      fetchFotos().then(fresh => cacheSet(fresh)).catch(() => {});
      return;
    }
    showSkeleton();
    try {
      const fotos = await fetchFotos();
      cacheSet(fotos);
      renderFotos(fotos);
    } catch {
      grid.innerHTML = '<p style="text-align:center;color:var(--texto-claro);padding:3rem">No se pudieron cargar las fotos.</p>';
    }
  }
  init();

  // ── Filtros ───────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.filtro-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.filtro-btn').forEach(b => b.classList.remove('activo'));
      btn.classList.add('activo');
      filtroActivo = btn.dataset.filtro!;
      mostrados    = LOTE;
      refreshGrid();
    });
  });

  // ── Ver más ───────────────────────────────────────────────────────────────
  document.getElementById('ver-mas-btn')?.addEventListener('click', () => {
    mostrados += LOTE;
    refreshGrid();
    requestAnimationFrame(() => {
      todosItems()
        .filter(el => !el.classList.contains('oculto') && !el.classList.contains('pag-oculto') && !el.classList.contains('in-view'))
        .forEach(el => el.classList.add('in-view'));
    });
  });

  // ── Lightbox ──────────────────────────────────────────────────────────────
  const lb         = document.getElementById('lightbox')!;
  const lbImg      = document.getElementById('lb-img') as HTMLImageElement;
  const lbCaption  = document.getElementById('lb-caption')!;
  const lbClose    = document.getElementById('lb-close')!;
  const lbPrev     = document.getElementById('lb-prev')!;
  const lbNext     = document.getElementById('lb-next')!;
  const lbBackdrop = document.getElementById('lb-backdrop')!;

  let cur = 0;
  let visible: HTMLElement[] = [];

  function abrir(idx: number) {
    visible = Array.from(document.querySelectorAll<HTMLElement>('.foto-item:not(.oculto):not(.pag-oculto)'));
    cur = idx;
    mostrar();
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function cerrar() { lb.classList.remove('open'); document.body.style.overflow = ''; }
  function mostrar() {
    const el = visible[cur];
    if (!el) return;
    lbImg.src = (el.querySelector('.foto-img img') as HTMLImageElement)?.src ?? '';
    lbCaption.textContent = `${el.querySelector('.foto-titulo')?.textContent ?? ''} — ${el.querySelector('.foto-desc')?.textContent ?? ''}`;
  }

  lbClose.addEventListener('click', cerrar);
  lbBackdrop.addEventListener('click', cerrar);
  lbPrev.addEventListener('click', () => { cur = (cur - 1 + visible.length) % visible.length; mostrar(); });
  lbNext.addEventListener('click', () => { cur = (cur + 1) % visible.length; mostrar(); });
  document.addEventListener('keydown', e => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape')     cerrar();
    if (e.key === 'ArrowLeft')  { cur = (cur - 1 + visible.length) % visible.length; mostrar(); }
    if (e.key === 'ArrowRight') { cur = (cur + 1) % visible.length; mostrar(); }
  });
</script>
