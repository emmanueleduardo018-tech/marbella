---
import { cldUrl } from '../lib/cloudinary';

const aboutImg1 = cldUrl('IMG-20260525-WA0015_xtajrb', 'f_auto,q_auto,c_fill,g_auto,w_800,ar_4:5');
const aboutImg2 = cldUrl('20250621_143713_dt45vy', 'f_auto,q_auto,c_fill,g_auto,w_600,ar_1:1');

const valores = [
  {
    titulo: 'Con amor',
    desc: 'Cada evento lo vivimos como si fuera el nuestro. Tu alegría es nuestra motivación.',
    svg: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 27S6 20 6 13a6 6 0 0 1 10-4.47A6 6 0 0 1 26 13c0 7-10 14-10 14z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>`,
  },
  {
    titulo: 'Con detalle',
    desc: 'Nada es demasiado pequeño si hace la diferencia. Cada detalle suma a la experiencia total.',
    svg: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.5"/>
      <path d="M16 10v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M8 4l2 2M24 4l-2 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>`,
  },
  {
    titulo: 'Con confianza',
    desc: 'Comunicación honesta y transparente siempre. Sabrás exactamente qué pasa en cada momento.',
    svg: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 4l2.4 7.4H26l-6.2 4.5 2.4 7.4L16 19l-6.2 4.3 2.4-7.4L6 11.4h7.6L16 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>`,
  },
];

const hitos = [
  { año: '2016', label: 'Inicio', desc: 'Primer evento organizado con amor' },
  { año: '2018', label: 'Crecemos', desc: '100 eventos y primer equipo' },
  { año: '2021', label: 'Expansión', desc: 'Nuevos servicios: Cabina 360° y Espejo' },
  { año: '2025', label: 'Hoy', desc: '+500 eventos y familias felices' },
];
---

<section class="nosotros" id="nosotros">

  <!-- Fondo decorativo -->
  <div class="nosotros-deco" aria-hidden="true">
    <div class="deco-linea dl1"></div>
    <div class="deco-linea dl2"></div>
  </div>

  <div class="container">
    <div class="grid-nosotros">

      <!-- Collage de imágenes -->
      <div class="collage reveal-left">
        <div class="foto-marco grande">
          <img
            src={aboutImg1}
            alt="Decoración de XV años con flores y detalles elegantes - Marbella Princess Parties"
            class="foto"
            loading="lazy"
          />
        </div>
        <div class="fotos-col">
          <div class="foto-marco chica">
            <img
              src={aboutImg2}
              alt="Detalle de decoración floral para evento XV años en Tijuana"
              class="foto"
              loading="lazy"
            />
          </div>
          <!-- <div class="foto-marco chica">
            <img
              src="https://lh3.googleusercontent.com/d/1fTLq_7DsyVgs5dF9_bOiRd6byXBov22x"
              alt="Espejo mágico interactivo para XV años - Marbella Princess Parties Tijuana"
              class="foto"
              loading="lazy"
            />
          </div> -->
        </div>

        <!-- Badge flotante -->
        <div class="badge-anos">
          <span class="badge-num">+8</span>
          <span class="badge-label">años creando<br/>magia</span>
          <svg class="badge-estrella" viewBox="0 0 20 20" fill="none" width="16" height="16">
            <path d="M10 1l2.4 7.4H20l-6.2 4.5 2.4 7.4L10 16l-6.2 4.3 2.4-7.4L0 8.4h7.6L10 1z" fill="rgba(255,255,255,0.5)"/>
          </svg>
        </div>
      </div>

      <!-- Texto -->
      <div class="texto reveal-right">
        <span class="eyebrow">Conócenos</span>
        <h2 class="sec-titulo">
          Detrás de cada evento<br/>
          <em>hay un equipo con corazón</em>
        </h2>
        <div class="sep"><span class="sep-icon">💖</span></div>

        <p class="parrafo">
          Somos Marbella Princess Parties, un equipo apasionado por convertir tus celebraciones en momentos mágicos que se quedan en el corazón para siempre. Nacimos del amor por los eventos y la convicción de que cada persona merece vivir su día especial exactamente como lo imagina.
        </p>
        <p class="parrafo">
          Con más de 8 años de experiencia, hemos acompañado a cientos de familias en sus momentos más importantes — bodas, quinceañeras, graduaciones, bautizos y mucho más. Cada evento es único y lo tratamos con ese mismo amor.
        </p>

        <!-- Valores -->
        <div class="valores">
          {valores.map(v => (
            <div class="valor">
              <div class="valor-icono" set:html={v.svg} />
              <div class="valor-texto">
                <strong class="valor-titulo">{v.titulo}</strong>
                <p class="valor-desc">{v.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <a href="#contacto" class="btn-rosa" style="margin-top: 2.25rem; width: fit-content; display: inline-flex;" data-track="cta_click" data-track-location="about">
          <span>Platiquemos de tu evento</span>
          <span>💬</span>
        </a>
      </div>
    </div>

    <!-- Timeline horizontal -->
    <!-- <div class="timeline reveal">
      <div class="timeline-linea" aria-hidden="true"></div>
      {hitos.map((h, i) => (
        <div class="hito" style={`animation-delay: ${i * 0.12}s`}>
          <div class="hito-punto"></div>
          <div class="hito-año">{h.año}</div>
          <strong class="hito-label">{h.label}</strong>
          <p class="hito-desc">{h.desc}</p>
        </div>
      ))}
    </div>
  </div>  -->
</section>

<style>
.nosotros {
  padding: 7rem 0;
  background: linear-gradient(180deg, var(--blanco) 0%, var(--crema) 100%);
  position: relative;
  overflow: hidden;
}
.nosotros::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--rosa-suave), transparent);
}

/* Deco */
.nosotros-deco { position: absolute; inset: 0; pointer-events: none; }
.deco-linea {
  position: absolute;
  width: 1px;
  background: linear-gradient(to bottom, transparent, rgba(247,197,208,0.3), transparent);
}
.dl1 { left: 8%; height: 80%; top: 10%; }
.dl2 { right: 8%; height: 70%; top: 15%; }

/* Layout */
.grid-nosotros {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  margin-bottom: 5rem;
}

/* Collage */
.collage {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.75rem;
  height: 520px;
}

.foto-marco {
  border-radius: 20px;
  overflow: hidden;
  position: relative;
}
.foto-marco.grande {
  grid-row: 1;
}
.fotos-col {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.foto-marco.chica {
  flex: 1;
  border-radius: 16px;
  min-width: 140px;
}

.foto {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.6s ease;
}
.foto-marco:hover .foto { transform: scale(1.04); }

.foto-marco::after {
  content: '';
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
  border-radius: inherit;
  pointer-events: none;
}

/* Badge años */
.badge-anos {
  position: absolute;
  bottom: -1.5rem;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, var(--rosa-oscuro) 0%, var(--rosa-intenso) 100%);
  color: white;
  border-radius: 18px;
  padding: 1.1rem 1.6rem;
  text-align: center;
  z-index: 5;
  box-shadow: 0 12px 40px rgba(201, 95, 120, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  animation: flotar 5s ease-in-out infinite;
}
.badge-num {
  font-family: var(--fuente-titulo);
  font-size: 2rem;
  font-weight: 700;
  line-height: 1;
}
.badge-label {
  font-size: 0.58rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.85;
  line-height: 1.4;
}
.badge-estrella {
  margin-top: 0.2rem;
  opacity: 0.6;
}

/* Texto */
.sec-titulo {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 600;
  color: var(--texto);
  line-height: 1.2;
  margin-bottom: 0;
}
.sec-titulo em {
  display: block;
  font-style: italic;
  color: var(--rosa-oscuro);
  font-weight: 400;
  font-family: var(--fuente-script);
  font-size: 1.15em;
  line-height: 1;
}
.parrafo {
  font-size: 0.9rem;
  color: var(--texto-medio);
  line-height: 1.95;
  margin-bottom: 0.85rem;
}

/* Valores */
.valores {
  margin-top: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding-top: 2rem;
  border-top: 1px solid var(--crema-borde);
}
.valor {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}
.valor-icono {
  width: 36px;
  height: 36px;
  color: var(--rosa);
  flex-shrink: 0;
  padding: 7px;
  background: var(--rosa-palido);
  border-radius: 10px;
  border: 1px solid var(--rosa-suave);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
.valor:hover .valor-icono {
  background: var(--rosa);
  color: white;
  transform: scale(1.08);
}
.valor-titulo {
  display: block;
  font-family: var(--fuente-titulo);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--texto);
  margin-bottom: 0.2rem;
}
.valor-desc {
  font-size: 0.8rem;
  color: var(--texto-claro);
  line-height: 1.6;
}

/* Timeline */
.timeline {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin-top: 3rem;
  padding: 2.5rem 2rem 2rem;
  background: white;
  border: 1px solid var(--crema-borde);
  border-radius: 24px;
  box-shadow: var(--sombra-suave);
}
.timeline-linea {
  position: absolute;
  top: calc(2.5rem + 11px);
  left: calc(2rem + 12.5%);
  right: calc(2rem + 12.5%);
  height: 2px;
  background: linear-gradient(90deg, var(--rosa-suave), var(--dorado-claro), var(--rosa-suave));
}
.hito {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  padding: 0 0.5rem;
}
.hito-punto {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--rosa), var(--dorado));
  border: 3px solid white;
  box-shadow: 0 0 0 3px rgba(232,132,154,0.25);
  margin-bottom: 1.25rem;
  position: relative;
  z-index: 1;
}
.hito-año {
  font-family: var(--fuente-titulo);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--rosa-oscuro);
  margin-bottom: 0.25rem;
}
.hito-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--texto);
  display: block;
  margin-bottom: 0.3rem;
}
.hito-desc {
  font-size: 0.72rem;
  color: var(--texto-claro);
  line-height: 1.5;
}

@media (max-width: 960px) {
  .grid-nosotros { grid-template-columns: 1fr; gap: 4rem; }
  .collage { height: 380px; }
  .texto { text-align: center; }
  .valores { align-items: flex-start; }
  .badge-anos { bottom: -2rem; }
}

@media (max-width: 680px) {
  .timeline { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .timeline-linea { display: none; }
}

@media (max-width: 480px) {
  .collage { height: 300px; }
  .fotos-col { display: none; }
  .foto-marco.grande { grid-column: 1 / -1; }
}

@keyframes flotar {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%       { transform: translateX(-50%) translateY(-8px); }
}
</style>
