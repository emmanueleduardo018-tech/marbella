---
const valores = [
  { emoji:'💕', titulo:'Con amor',      desc:'Cada evento lo vivimos como si fuera el nuestro.' },
  { emoji:'✨', titulo:'Con detalle',   desc:'Nada es demasiado pequeño si hace la diferencia.' },
  { emoji:'🤝', titulo:'Con confianza', desc:'Comunicación honesta y transparente siempre.' },
];
---

<section class="nosotros" id="nosotros">
  <div class="container grid-nosotros">

    <!-- Collage de imágenes -->
    <div class="collage">
      <img
        src="https://lh3.googleusercontent.com/d/1cVSGuZ9_-P7gQgO5pKMyN2BgjiV-Aczu"
        alt="Decoración de XV años con flores y detalles elegantes - Marbella Princess Parties"
        class="foto f-grande"
        loading="lazy"
      />
      <img
        src="https://lh3.googleusercontent.com/d/1g5fLhbCpItT3BPgENCv1VcL7U7VDRF9J"
        alt="Detalle de decoración floral para evento XV años en Tijuana"
        class="foto f-chica"
        loading="lazy"
      />
      <img
        src="https://lh3.googleusercontent.com/d/1fTLq_7DsyVgs5dF9_bOiRd6byXBov22x"
        alt="Espejo mágico interactivo para XV años - Marbella Princess Parties Tijuana"
        class="foto f-chica2"
        loading="lazy"
      />
      <!-- Badge años -->
      <div class="badge-anos">
        <span class="badge-num">+8</span>
        <span class="badge-label">años<br/>creando<br/>magia</span>
      </div>
    </div>

    <!-- Texto -->
    <div class="texto">
      <span class="eyebrow">Conócenos</span>
      <h2 class="sec-titulo">
        Detrás de cada evento<br/>
        <em>hay un equipo con corazón</em>
      </h2>
      <div class="sep" style="margin:1.25rem 0;"><span class="sep-icon">💖</span></div>

      <p class="parrafo">
        Somos Marbella Princess Parties, un equipo apasionado por convertir tus celebraciones en momentos mágicos. Nacimos del amor por los eventos y la convicción de que cada persona merece vivir su día especial exactamente como lo imagina.
      </p>
      <p class="parrafo">
        Con más de 8 años de experiencia, hemos acompañado a cientos de familias en sus momentos más importantes — bodas, quinceañeras, graduaciones, bautizos y mucho más. Cada evento es único y lo tratamos como tal.
      </p>

      <div class="valores">
        {valores.map(v => (
          <div class="valor">
            <span class="valor-emoji">{v.emoji}</span>
            <div>
              <strong class="valor-titulo">{v.titulo}</strong>
              <p class="valor-desc">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <a href="#contacto" class="btn-rosa" style="margin-top:2rem;">
        Platiquemos de tu evento 💬
      </a>
    </div>
  </div>
</section>

<style>
.nosotros {
  padding: 6rem 0;
  background: linear-gradient(180deg, var(--blanco) 0%, var(--crema) 100%);
  position: relative;
  overflow: hidden;
}
.nosotros::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--rosa-suave), transparent);
}

.grid-nosotros {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem; align-items: center;
}

/* Collage */
.collage { position: relative; height: 500px; }
.foto {
  position: absolute;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 12px 36px rgba(232,132,154,0.15);
  transition: transform 0.4s ease;
  object-fit: cover;
  object-position: center;
  width: 100%;
  height: 100%;
}
.foto:hover { transform: scale(1.02); }
.f-grande { width: 68%; height: 72%; top: 0; left: 0; z-index: 2; }
.f-chica  { width: 46%; height: 46%; bottom: 0; right: 0; z-index: 3; }
.f-chica2 { width: 39%; height: 44%; top: 12%; right: 4%; z-index: 1; opacity: 0.7; }

.badge-anos {
  position: absolute; bottom: 16%; left: 52%;
  transform: translate(-50%, 50%);
  background: linear-gradient(135deg, var(--rosa), var(--rosa-oscuro));
  color: white;
  border-radius: 16px;
  padding: 0.9rem 1.25rem;
  text-align: center;
  z-index: 5;
  box-shadow: 0 8px 28px rgba(232,132,154,0.4);
}
.badge-num {
  display: block;
  font-family: var(--fuente-titulo);
  font-size: 1.8rem; font-weight: 700; line-height: 1;
}
.badge-label {
  font-size: 0.6rem; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase;
  line-height: 1.3; opacity: 0.9;
  display: block; margin-top: 0.2rem;
}

/* Texto */
.sec-titulo {
  font-size: clamp(1.7rem, 3vw, 2.3rem);
  font-weight: 600; color: var(--texto); line-height: 1.25;
}
.sec-titulo em {
  font-style: italic; color: var(--rosa-oscuro);
  font-weight: 400; font-size: 0.92em;
}
.parrafo {
  font-size: 0.9rem; color: var(--texto-medio);
  line-height: 1.9; margin-bottom: 0.9rem;
}

/* Valores */
.valores {
  margin-top: 1.75rem;
  display: flex; flex-direction: column; gap: 1rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--crema-borde);
}
.valor {
  display: flex; align-items: flex-start; gap: 0.9rem;
}
.valor-emoji { font-size: 1.3rem; flex-shrink: 0; margin-top: 0.1rem; }
.valor-titulo {
  display: block; font-size: 0.9rem;
  font-weight: 500; color: var(--texto); margin-bottom: 0.1rem;
}
.valor-desc { font-size: 0.8rem; color: var(--texto-claro); }

@media (max-width: 900px) {
  .grid-nosotros { grid-template-columns: 1fr; gap: 3rem; }
  .collage { height: 360px; max-width: 420px; margin: 0 auto; }
  .texto { text-align: center; }
  .valores { align-items: flex-start; }
}
@media (max-width: 480px) {
  .collage { height: 280px; }
  .f-chica2 { display: none; }
}
</style>
