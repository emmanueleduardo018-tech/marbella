---

<section class="servicios" id="servicios">
  <div class="servicios-deco" aria-hidden="true">
    <div class="deco-circulo dc1"></div>
    <div class="deco-circulo dc2"></div>
  </div>

  <div class="container">
    <div class="sec-header reveal">
      <span class="eyebrow">Lo que ofrecemos</span>
      <h2 class="sec-titulo">Servicios <em>mágicos</em></h2>
      <div class="sep"><span class="sep-icon">🎀</span></div>
      <p class="sec-desc">
        Todo lo que necesitas para que tu evento sea perfecto, en un solo lugar y con un equipo que lo vive contigo.
      </p>
    </div>

    <div class="grid">
      {servicios.map((s, i) => (
        <article
          class={`card reveal ${s.popular ? 'card-popular' : ''}`}
          data-i={i}
          style={`transition-delay: ${Math.min(i * 0.06, 0.42)}s`}
        >
          {s.popular && (
            <div class="popular-badge">
              <span>⭐ Más popular</span>
            </div>
          )}
          <span class="card-num-bg" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
          <div class="card-icon" set:html={s.svg} />
          <h3 class="card-titulo">{s.titulo}</h3>
          <p class="card-desc">{s.desc}</p>
          <div class="card-footer">
            <a href="#contacto" class="card-link" data-track="cta_click" data-track-location="servicios_card">
              Cotizar
              <svg viewBox="0 0 16 16" fill="none" width="12" height="12">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="sec-cta reveal">
      <p class="cta-texto">¿Quieres un paquete completo personalizado para tu evento?</p>
      <a href="#contacto" class="btn-rosa" data-track="cta_click" data-track-location="servicios_cta">
        <span>Cotiza sin compromiso</span>
        <span>💌</span>
      </a>
    </div>
  </div>
</section>

<style>
.servicios {
  padding: 7rem 0 6rem;
  background: var(--blanco);
  position: relative;
  overflow: hidden;
}

/* Decorativos */
.servicios-deco { position: absolute; inset: 0; pointer-events: none; }
.deco-circulo {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(247,197,208,0.15), transparent 70%);
}
.dc1 { width: 600px; height: 600px; top: -200px; right: -150px; }
.dc2 { width: 400px; height: 400px; bottom: -100px; left: -100px; }

/* Header */
.sec-header {
  text-align: center;
  max-width: 580px;
  margin: 0 auto 4.5rem;
}
.sec-titulo {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 600;
  color: var(--texto);
  line-height: 1.15;
}
.sec-titulo em {
  font-style: italic;
  color: var(--rosa-oscuro);
  font-weight: 400;
  font-family: var(--fuente-script);
  font-size: 1.1em;
}
.sec-desc {
  color: var(--texto-claro);
  font-size: 0.95rem;
  line-height: 1.85;
  margin-top: 0.75rem;
}

/* Grid */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
  margin-bottom: 4rem;
}

/* Card base */
.card {
  position: relative;
  background: white;
  border: 1px solid var(--crema-borde);
  border-radius: 20px;
  padding: 2.25rem 1.75rem 1.75rem;
  overflow: hidden;
  transition:
    transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    box-shadow 0.4s ease,
    border-color 0.4s ease;
  cursor: default;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Gradient border animation */
.card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  padding: 1.5px;
  background: linear-gradient(135deg, var(--rosa-suave), var(--dorado-claro), var(--rosa));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  transition: opacity 0.4s ease;
}

/* Glow effect */
.card::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background: linear-gradient(135deg, rgba(247,197,208,0.08) 0%, transparent 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 60px rgba(232, 132, 154, 0.2), 0 4px 16px rgba(61, 37, 53, 0.06);
  border-color: transparent;
}
.card:hover::before { opacity: 1; }
.card:hover::after  { opacity: 1; }

/* Número decorativo de fondo */
.card-num-bg {
  position: absolute;
  top: 0.75rem;
  right: 1rem;
  font-family: var(--fuente-titulo);
  font-size: 4.5rem;
  font-weight: 700;
  color: var(--rosa-palido);
  line-height: 1;
  pointer-events: none;
  transition: color 0.4s;
  user-select: none;
}
.card:hover .card-num-bg { color: rgba(247,197,208,0.6); }

/* Icon */
.card-icon {
  width: 48px;
  height: 48px;
  color: var(--rosa);
  margin-bottom: 1.25rem;
  transition: color 0.4s, transform 0.4s;
  position: relative;
  z-index: 1;
}
.card:hover .card-icon {
  color: var(--rosa-oscuro);
  transform: scale(1.1) rotate(-3deg);
}

.card-titulo {
  font-family: var(--fuente-titulo);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--texto);
  margin-bottom: 0.6rem;
  position: relative;
  z-index: 1;
}
.card-desc {
  font-size: 0.82rem;
  color: var(--texto-claro);
  line-height: 1.75;
  flex: 1;
  position: relative;
  z-index: 1;
}
.card-footer {
  margin-top: 1.25rem;
  padding-top: 1rem;
  border-top: 1px solid var(--crema-borde);
  position: relative;
  z-index: 1;
  transition: border-color 0.4s;
}
.card:hover .card-footer { border-color: rgba(247,197,208,0.5); }

.card-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--texto-claro);
  transition: color 0.3s, gap 0.3s;
}
.card-link:hover,
.card:hover .card-link { color: var(--rosa-oscuro); gap: 0.6rem; }

/* Popular card */
.card-popular {
  background: linear-gradient(145deg, var(--oscuro) 0%, var(--oscuro-medio) 100%);
  border-color: rgba(212,169,106,0.3);
}
.card-popular .card-num-bg { color: rgba(255,255,255,0.04); }
.card-popular .card-icon   { color: var(--dorado); }
.card-popular .card-titulo { color: white; }
.card-popular .card-desc   { color: rgba(255,255,255,0.55); }
.card-popular .card-footer { border-color: rgba(212,169,106,0.2); }
.card-popular .card-link   { color: var(--dorado-claro); }
.card-popular:hover {
  border-color: rgba(212,169,106,0.5);
  box-shadow: 0 24px 64px rgba(26, 13, 18, 0.4), 0 0 0 1px rgba(212,169,106,0.3);
  transform: translateY(-10px);
}
.card-popular::before {
  background: linear-gradient(135deg, rgba(212,169,106,0.4), rgba(232,132,154,0.3), rgba(212,169,106,0.4));
}
.card-popular:hover .card-icon { color: var(--dorado-claro); transform: scale(1.1) rotate(-3deg); }

.popular-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: linear-gradient(135deg, var(--dorado), var(--dorado-dim));
  border-radius: 50px;
  padding: 0.3rem 0.8rem;
  z-index: 2;
}
.popular-badge span {
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: white;
  text-transform: uppercase;
}

/* CTA */
.sec-cta {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}
.cta-texto {
  color: var(--texto-medio);
  font-size: 0.95rem;
}

@media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 760px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 460px)  { .grid { grid-template-columns: 1fr; } }
</style>
