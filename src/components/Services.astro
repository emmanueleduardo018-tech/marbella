---
const servicios = [
  { emoji:'🌸', titulo:'Decoración',         desc:'Ambientaciones únicas que transforman cualquier espacio en el escenario perfecto de tu sueño.' },
  { emoji:'📋', titulo:'Coordinación',        desc:'Nos encargamos de todo desde la planeación hasta el último detalle. ¡Tú solo disfruta!' },
  { emoji:'🪑', titulo:'Renta de Mobiliario', desc:'Sillas Tiffany, mesas, lounge, arcos y más para completar el montaje de tus sueños.' },
  { emoji:'🍭', titulo:'Snack Bar',           desc:'Estaciones de botanas y bocadillos presentadas de forma linda y deliciosa para tus invitados.' },
  { emoji:'🎂', titulo:'Mesa de Postres',     desc:'Candy bar temático con postres, dulces y treats que son arte visual y deleite para el paladar.' },
  { emoji:'📸', titulo:'Cabina de Fotos',     desc:'Diversión y recuerdos instantáneos con accesorios adorables y fondos personalizados.' },
  { emoji:'🎥', titulo:'Cabina 360',          desc:'Videos 360° con slow-motion que son el hit de cualquier fiesta. ¡El detalle que todos recuerdan!' },
  { emoji:'🪞', titulo:'Espejo Mágico',       desc:'Un espejo interactivo con animaciones, firmas digitales y mensajes que sorprenden a todos.' },
];
---

<section class="servicios" id="servicios">

  <!-- Fondo decorativo de puntos -->
  <div class="servicios-bg" aria-hidden="true"></div>

  <div class="container">
    <div class="sec-header">
      <span class="eyebrow">Nuestros</span>
      <h2 class="sec-titulo">Servicios <em>mágicos</em></h2>
      <div class="sep"><span class="sep-icon">🎀</span></div>
      <p class="sec-desc">
        Todo lo que necesitas para que tu evento sea perfecto, en un solo lugar.
      </p>
    </div>

    <div class="grid">
      {servicios.map((s, i) => (
        <article class="card reveal">
          <div class="card-emoji">{s.emoji}</div>
          <h3 class="card-titulo">{s.titulo}</h3>
          <p class="card-desc">{s.desc}</p>
          <span class="card-num">{String(i+1).padStart(2,'0')}</span>
        </article>
      ))}
    </div>

    <div class="sec-cta">
      <p>¿Quieres un paquete completo a tu medida?</p>
      <a href="#contacto" class="btn-rosa">Cotiza sin compromiso 💌</a>
    </div>
  </div>
</section>

<style>
.servicios {
  padding: 6rem 0 5rem;
  background: var(--blanco);
  position: relative;
  overflow: hidden;
}
.servicios-bg {
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, var(--rosa-suave) 1px, transparent 1px);
  background-size: 30px 30px;
  opacity: 0.2;
  pointer-events: none;
}

/* Header */
.sec-header {
  text-align: center;
  max-width: 560px;
  margin: 0 auto 4rem;
}
.sec-titulo {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 600; color: var(--texto);
}
.sec-titulo em {
  font-style: italic; color: var(--rosa-oscuro);
  font-weight: 400;
}
.sec-desc {
  color: var(--texto-claro); font-size: 0.95rem;
  line-height: 1.8; margin-top: 0.75rem;
}

/* Grid */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}

/* Card */
.card {
  position: relative;
  background: white;
  border: 1px solid var(--crema-borde);
  border-radius: 18px;
  padding: 2rem 1.5rem 1.75rem;
  overflow: hidden;
  transition: var(--transicion);
  cursor: default;
}
.card::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--rosa-suave), var(--rosa));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s ease;
}
.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 40px rgba(232,132,154,0.18);
  border-color: var(--rosa-suave);
}
.card:hover::before { transform: scaleX(1); }

.card-emoji {
  font-size: 2.2rem; margin-bottom: 1rem;
  display: block;
  transition: transform 0.3s ease;
}
.card:hover .card-emoji { transform: scale(1.15) rotate(-5deg); }

.card-titulo {
  font-family: var(--fuente-titulo);
  font-size: 1.15rem; font-weight: 600;
  color: var(--texto); margin-bottom: 0.6rem;
}
.card-desc {
  font-size: 0.83rem; color: var(--texto-claro);
  line-height: 1.7;
}
.card-num {
  position: absolute; top: 1rem; right: 1.25rem;
  font-family: var(--fuente-titulo);
  font-size: 2rem; font-weight: 700;
  color: var(--rosa-palido);
  line-height: 1;
}

/* CTA */
.sec-cta {
  text-align: center;
  margin-top: 3.5rem;
  display: flex; flex-direction: column;
  align-items: center; gap: 1.25rem;
}
.sec-cta p {
  color: var(--texto-medio); font-size: 0.95rem;
}

/* Reveal */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.reveal.in-view { opacity: 1; transform: none; }

@media (max-width: 1100px) { .grid { grid-template-columns: repeat(3,1fr); } }
@media (max-width: 760px)  { .grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 460px)  { .grid { grid-template-columns: 1fr; } }
</style>
