---
/**
 * Google Tag Manager — punto central de analítica.
 *
 * GTM es el único contenedor que se inserta en el sitio; el resto de
 * proveedores (GA4, Microsoft Clarity, Meta Pixel, Google Ads) se configuran
 * desde la UI de GTM, no en el código.
 *
 * El ID se lee en build-time (`import.meta.env.GTM_CONTAINER_ID`) y se
 * incrusta en el HTML estático. Si la variable no existe, el componente no
 * renderiza nada: la app sigue funcionando sin errores.
 *
 * Uso (ver src/layouts/Layout.astro):
 *   <GoogleTagManager placement="head" />  → <script> dentro de <head>
 *   <GoogleTagManager placement="body" />  → <noscript> tras <body>
 */

interface Props {
  /** Dónde se coloca el snippet: el script va en <head>, el noscript en <body>. */
  placement: 'head' | 'body';
}

const { placement } = Astro.props;
const gtmId = import.meta.env.GTM_CONTAINER_ID;
---
{gtmId && placement === 'head' && (
  <script is:inline define:vars={{ gtmId }}>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', gtmId);
  </script>
)}
{gtmId && placement === 'body' && (
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"
      title="Google Tag Manager"
    ></iframe>
  </noscript>
)}
